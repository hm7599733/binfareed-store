# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Connection String
# Replace with your MongoDB Atlas cluster URI in production:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/binfareedstore?retryWrites=true&w=majority
# When left blank in development, the server automatically starts an embedded MongoDB instance and seeds initial catalog data.
MONGODB_URI=

# Authentication & Security Secrets
JWT_SECRET=replace_with_a_strong_64_char_random_hex_secret_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Cloudinary Image Storage Configuration (Optional in dev - falls back to local /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway Integration (Stripe / SafePay Webhook Verification)
PAYMENT_PROVIDER=safepay
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_signing_secret

# Default Admin Credentials for Seed Script
ADMIN_EMAIL=admin@binfareedstore.pk
ADMIN_PASSWORD=Admin@BinFareed2026!

# Web Push (browser notifications). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
